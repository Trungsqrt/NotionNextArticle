# ─────────────────────────────────────────────
#  ServiceNow Knowledge Hub — Environment Config
# ─────────────────────────────────────────────

# Your root Notion page ID (the database / page that drives the site)
# Format: 32-character hex string (remove dashes from the Notion URL UUID)
NOTION_ROOT_PAGE_ID=your_notion_page_id_here

# Optional: Notion internal integration token (needed for private pages)
# Generate at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_token_here

# Site metadata
NEXT_PUBLIC_SITE_NAME="ServiceNow Knowledge Hub"
NEXT_PUBLIC_SITE_DESCRIPTION="A serene learning space for mastering ServiceNow — curated notes, labs, and knowledge cards."
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NOTION_API_SECRET=

# Explicit Articles database ID for the local translation worker
# (Falls back to NOTION_ROOT_PAGE_ID if omitted)
NOTION_TRANSLATION_DATABASE_ID=your_articles_database_id_here

# AI translation configuration
# Supported AI_PROVIDER values: groq | openrouter | openai | openai-compatible | gemini | anthropic | deepseek
AI_PROVIDER=groq
AI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3-32b

# Local translation worker settings
TRANSLATION_POLL_INTERVAL_MS=60000
TRANSLATION_TARGET_LOCALE=vi
TRANSLATION_BATCH_SIZE=20
TRANSLATION_MAX_BATCH_CHARS=6000
TRANSLATION_MAX_INPUT_TOKENS_PER_BATCH=1800
TRANSLATION_MAX_OUTPUT_TOKENS=4096
TRANSLATION_CONCURRENCY=1
TRANSLATION_STALE_TIMEOUT_MS=1800000

# Optional rate-limit & daily quota caps (0 = provider default / unlimited)
TRANSLATION_RPM_LIMIT=0
TRANSLATION_TPM_LIMIT=0
TRANSLATION_RPD_LIMIT=0
TRANSLATION_TPD_LIMIT=0

# Optional ServiceNow glossary & custom protected object names
# (Default glossary: lib/notion-translation/servicenow-glossary.json)
TRANSLATION_GLOSSARY_PATH=
TRANSLATION_CUSTOM_TERMS="New Hire Hardware Request"
TRANSLATION_DISABLE_REASONING=true

# Optional cost estimation per 1M tokens (USD)
TRANSLATION_INPUT_COST_PER_1M=0
TRANSLATION_OUTPUT_COST_PER_1M=0

# Request timeouts, media size limit, and pagination safety limits
TRANSLATION_AI_TIMEOUT_MS=120000
TRANSLATION_NOTION_TIMEOUT_MS=30000
TRANSLATION_ASSET_TIMEOUT_MS=60000
TRANSLATION_MAX_ASSET_BYTES=20971520
TRANSLATION_MAX_PAGINATION_PAGES=500
