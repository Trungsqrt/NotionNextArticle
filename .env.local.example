# ─────────────────────────────────────────────
#  ServiceNow Knowledge Hub — Environment Config
# ─────────────────────────────────────────────

# Your root Notion page ID (the database / page that drives the site)
# Format: 32-character hex string (remove dashes from the Notion URL UUID)
NOTION_ROOT_PAGE_ID=your_notion_page_id_here

# Optional: Notion internal integration token (needed for private pages)
# Generate at: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_your_notion_token_here

# Site metadata
NEXT_PUBLIC_SITE_NAME="ServiceNow Knowledge Hub"
NEXT_PUBLIC_SITE_DESCRIPTION="A serene learning space for mastering ServiceNow — curated notes, labs, and knowledge cards."
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Analytics 4 (GA4) Measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to disable Google Analytics tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Formspree Form ID for the /contact & article feedback form (e.g. xabcdefg)
# Leave empty to show a friendly unavailable notice on /contact
NEXT_PUBLIC_FORMSPREE_FORM_ID=

NOTION_API_SECRET=

# Explicit Articles database ID for the local translation worker
# (Falls back to NOTION_ROOT_PAGE_ID if omitted)
NOTION_TRANSLATION_DATABASE_ID=your_articles_database_id_here

# Dedicated Notion Translation Mapping database ID for child page mappings
# (Defaults to 415ac39b-0efb-8050-9ab4-ecb760e41cc5 if omitted)
NOTION_TRANSLATION_MAPPING_DATABASE_ID=415ac39b-0efb-8050-9ab4-ecb760e41cc5

# AI translation configuration
# Supported AI_PROVIDER values: groq | openrouter | openai | openai-compatible | gemini | anthropic | deepseek
AI_PROVIDER=groq
AI_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3-32b

# Local translation worker settings
TRANSLATION_POLL_INTERVAL_MS=60000
TRANSLATION_TARGET_LOCALE=vi
TRANSLATION_BATCH_SIZE=60
TRANSLATION_MAX_BATCH_SEGMENTS=80
TRANSLATION_MAX_BATCH_CHARS=12000
TRANSLATION_MAX_INPUT_TOKENS_PER_BATCH=4500
TRANSLATION_TARGET_OUTPUT_TOKENS_PER_BATCH=5000
TRANSLATION_MIN_OUTPUT_TOKENS=2048
TRANSLATION_MAX_OUTPUT_TOKENS=8192
TRANSLATION_OUTPUT_SAFETY_MARGIN=1.8
TRANSLATION_ASSUMED_OUTPUT_TPS=53
TRANSLATION_CONCURRENCY=1
TRANSLATION_STALE_TIMEOUT_MS=1800000

# Optional rate-limit & daily quota caps (0 = provider default / unlimited)
TRANSLATION_RPM_LIMIT=0
TRANSLATION_TPM_LIMIT=0
TRANSLATION_RPD_LIMIT=0
TRANSLATION_TPD_LIMIT=0

# Optional ServiceNow glossary & custom protected object names
# (Default glossary: lib/notion-translation/servicenow-glossary.json)
TRANSLATION_GLOSSARY_PATH=
TRANSLATION_CUSTOM_TERMS="New Hire Hardware Request"
TRANSLATION_DISABLE_REASONING=true

# Optional cost estimation per 1M tokens (USD)
TRANSLATION_INPUT_COST_PER_1M=0
TRANSLATION_OUTPUT_COST_PER_1M=0

# Request timeouts, media size limit, and pagination safety limits
TRANSLATION_AI_TIMEOUT_MS=120000
TRANSLATION_NOTION_TIMEOUT_MS=30000
TRANSLATION_ASSET_TIMEOUT_MS=60000
TRANSLATION_MAX_ASSET_BYTES=20971520
TRANSLATION_MAX_PAGINATION_PAGES=500

# ─────────────────────────────────────────────
#  Private Study System — Isolated Notion Config
# ─────────────────────────────────────────────
# IMPORTANT: Create a SEPARATE Notion internal integration for the private
# "Study System" workspace area. Never connect NOTION_TOKEN to Study System DBs
# and never connect STUDY_NOTION_TOKEN to public Knowledge Hub databases.
STUDY_NOTION_TOKEN=secret_your_private_study_notion_token_here
STUDY_NOTION_USERS_DB_ID=your_study_users_database_id_here
STUDY_NOTION_EXAMS_DB_ID=your_exam_collections_database_id_here
STUDY_NOTION_QUESTIONS_DB_ID=your_question_bank_database_id_here
STUDY_NOTION_CARD_STATES_DB_ID=your_fsrs_card_state_database_id_here
STUDY_NOTION_REVIEW_EVENTS_DB_ID=your_review_events_database_id_here
STUDY_NOTION_BOOKMARKS_DB_ID=your_study_bookmarks_database_id_here

# Optional private Study Notion client tuning
STUDY_NOTION_TIMEOUT_MS=15000
STUDY_NOTION_MAX_RETRIES=3
STUDY_NOTION_MIN_INTERVAL_MS=350
STUDY_NOTION_MAX_PAGINATION_PAGES=100
# Optional server-side TTL cache for published exams & questions (ms, default 300000 = 5m, bounds 10s–30m)
STUDY_CONTENT_CACHE_TTL_MS=300000

# Private Study Room session signing (minimum 32 random characters; never commit)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDY_SESSION_SECRET=replace_with_at_least_32_random_characters_for_hmac_signing
STUDY_SESSION_TTL_HOURS=168

# Optional distributed rate limiting & per-card lease locks via Upstash Redis REST API
# Falls back to per-instance in-memory rate limiting when omitted (suitable for small personal deployments;
# pair with Vercel Firewall WAF rules on /api/study/auth/login or configure Upstash for global limits).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set to "true" to fail closed (503) on /api/study/auth/login if Upstash Redis is unconfigured/unreachable
STUDY_RATE_LIMIT_FAIL_CLOSED=false
